# fdt-notion-api — variables de entorno
# Copiar a .env y llenar. Nunca subir el .env real a git (ver .gitignore).

PORT=3001
NODE_ENV=development

# ── Autenticación de ESTE servicio (quién puede llamarlo) ──────────────
# Genera una clave propia, no reuses la de platica-google-docs-api.
API_SECRET_KEY=

# ── Notion ───────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_CONTACTOS_DATA_SOURCE_ID=a0bc0e2f-e795-4931-b647-8a311d855c07
NOTION_CITAS_DATA_SOURCE_ID=e589d487-b3db-4d9b-8ec1-6d0119728aca

# ── Servicio de Calendar de Plática (platica-google-docs-api) ──────────
# Este repo NO tiene credenciales de Google propias — llama por HTTP al
# servicio que ya está en producción.
GOOGLE_API_BASE_URL=https://uoo48gc0og4ss0osg8kso0g8.appsplatica.site
# El X-API-Key de ESE servicio — corresponde a su variable API_SECRET_KEY,
# NO a GOOGLE_CLIENT_SECRET ni a OAUTH_TOKEN_SECRET (son cosas distintas).
# Pídeselo a Ernesto/Adler, es distinto del API_SECRET_KEY de arriba (ese
# es el de ESTE repo, este es el del repo de Google).
GOOGLE_API_KEY=
# El cliente_id de FDT una vez conectado por OAuth en platica-google-docs-api.
#
# ⚠️ platica-google-docs-api soporta DOS modelos de autenticación con
# Google — FDT usa el Modelo 2 (OAuth por cliente, confirmado por Adler el
# 16 de julio), no el Modelo 1 (cuenta única de la agencia con
# GOOGLE_REFRESH_TOKEN fijo). Esto importa porque son flujos de conexión
# distintos — si alguien intenta conectar FDT como si fuera Modelo 1, no
# va a funcionar.
#
# Vacío hasta que Adler complete esa conexión. El punto de entrada más
# probable es POST /clientes/registrar en ese repo (según el comentario de
# su propio .env.example) — no verificado end-to-end, confirmar con
# Ernesto si el endpoint no existe o se llama distinto.
GOOGLE_API_CLIENTE_ID=
