# fdt-notion-api — variables de entorno
# Copiar a .env y llenar. Nunca subir el .env real a git (ver .gitignore).

PORT=3001
NODE_ENV=development

# ── Autenticación de ESTE servicio (quién puede llamarlo) ──────────────
# Genera una clave propia, no reuses la de platica-google-docs-api.
API_SECRET_KEY=

# ── Notion ───────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_CONTACTOS_DATA_SOURCE_ID=a0bc0e2f-e795-4931-b647-8a311d855c07
NOTION_CITAS_DATA_SOURCE_ID=e589d487-b3db-4d9b-8ec1-6d0119728aca
# Contacto ficticio de bloqueo de conferencias. Default en código = page
# de Adler en Contactos (nueva). Vacío desactiva la exclusión de mesas.
#
# ⚠️ Si los data sources de arriba son los de PRODUCCIÓN (prefijo 3b162dda,
# workspace de Laura), esta variable es obligatoria y debe traer el page_id
# del contacto ficticio de ESE workspace: el servicio NO arranca con el
# default de pruebas, vacía, o sin configurar. Sin eso, las conferencias
# volverían a restar mesas de las 11 sin ningún error visible.
NOTION_CONTACTO_BLOQUEO_AGENDA_ID=3c990fe2-7345-8121-92a6-f9e09a540d2e

# ── Servicio de Calendar de Plática (platica-google-docs-api) ──────────
# Este repo NO tiene credenciales de Google propias — llama por HTTP al
# servicio que ya está en producción.
GOOGLE_API_BASE_URL=https://uoo48gc0og4ss0osg8kso0g8.appsplatica.site
# El X-API-Key de ESE servicio — corresponde a su variable API_SECRET_KEY,
# NO a GOOGLE_CLIENT_SECRET ni a OAUTH_TOKEN_SECRET (son cosas distintas).
# Pídeselo a Ernesto/Adler, es distinto del API_SECRET_KEY de arriba (ese
# es el de ESTE repo, este es el del repo de Google).
GOOGLE_API_KEY=
# El cliente_id de FDT una vez conectado por OAuth en platica-google-docs-api.
#
# ⚠️ platica-google-docs-api soporta DOS modelos de autenticación con
# Google — FDT usa el Modelo 2 (OAuth por cliente, confirmado por Adler el
# 16 de julio), no el Modelo 1 (cuenta única de la agencia con
# GOOGLE_REFRESH_TOKEN fijo). Esto importa porque son flujos de conexión
# distintos — si alguien intenta conectar FDT como si fuera Modelo 1, no
# va a funcionar.
#
# Vacío hasta que Adler complete esa conexión. El punto de entrada más
# probable es POST /clientes/registrar en ese repo (según el comentario de
# su propio .env.example) — no verificado end-to-end, confirmar con
# Ernesto si el endpoint no existe o se llama distinto.
GOOGLE_API_CLIENTE_ID=

# ── Horario de citas 1-a-1 (para GET /citas/disponibilidad) ────────────
# Confirmado por Laura el 14 de agosto — NO es el horario general del
# evento (9am-7pm), es específicamente el horario de citas 1-a-1, y es
# DISTINTO cada día. Si Laura ajusta el horario más adelante, cambiar
# aquí y en Coolify + redeploy — nunca hardcodeado en el código
# (ver citas.service.js → obtenerDisponibilidadSponsor).
#
# ⚠️ Cargar los MISMOS valores reales en Coolify (Application → Environment
# Variables). Este archivo documenta el formato; en producción no se lee.
#
# ⚠️ Coolify NO inyecta Names con guiones (bug/limitación confirmada 14-ago:
# las vars CITAS_HORA_*_2026-10-07 se veían en la UI pero process.env las
# tenía undefined). Usar underscores en la fecha del Name:
# CITAS_HORA_INICIO_2026_10_07. El query param del API sigue siendo
# "2026-10-07" (con guiones); solo cambia la clave de entorno.
CITAS_FECHAS_EVENTO=2026-10-07,2026-10-08

# Miércoles 7 de octubre: 10:30am – 7:00pm
CITAS_HORA_INICIO_2026_10_07=10:30
CITAS_HORA_FIN_2026_10_07=19:00

# Jueves 8 de octubre: 9:00am – 6:00pm
CITAS_HORA_INICIO_2026_10_08=09:00
CITAS_HORA_FIN_2026_10_08=18:00

# Duración de cada bloque de cita — 30 min, confirmado por Laura desde
# la sesión del 13 de julio (11 mesas máximo por bloque, mismo valor que
# CAPACIDAD_MAXIMA_MESAS en booking.service.js).
CITAS_DURACION_BLOQUE_MINUTOS=30

# Offset fijo de México. No se usa horario de verano en la práctica de
# este proyecto (el evento es en octubre, ya sin cambio de horario).
CITAS_ZONA_HORARIA_OFFSET=-06:00

# ── Correo de confirmación (.ics) ─────────────────────────────────────
# SMTP (Gmail App Password). Tras confirmar la cita en Notion se envía
# invitación .ics al sponsor y al asistente. Cada envío se reintenta hasta
# 3 veces de inmediato (timeouts). Si tras eso falla → Estatus
# "Confirmada sin notificar" (reenviable a demanda vía endpoint/MCP,
# sin tope de llamadas).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=Fashion Digital Talks

# ── WhatsApp Flow (webhook Plática → este servicio) ───────────────────
# La ruta POST /webhooks/whatsapp-flows se despliega en Coolify.
# El REGISTRO del webhook (url + evento whatsapp.flows.exchanges + secret)
# se hace en Plática, no en Coolify.
FLOW_WEBHOOK_SECRET=
FLOW_NOTION_TIMEOUT_MS=500
PLATICA_FLOW_ID=

# API de Plática para avisos 2.2 / 2.3 tras reservar
PLATICA_API_BASE_URL=https://api.platica.mx
PLATICA_API_KEY=
PLATICA_CHANNEL_ID=
PLATICA_TEMPLATE_CITA_ASISTENTE=
PLATICA_TEMPLATE_CITA_SPONSOR=

# ── Campañas manuales de matchmaking ─────────────────────────────────
# El webhook de Notion vive fuera de X-API-Key y usa este secret propio.
NOTION_CAMPANAS_WEBHOOK_SECRET=
# Mantener true hasta aprobar copy y las 5 variables de la plantilla en Meta.
CAMPANAS_MATCHMAKING_MODO_SIMULACION=true
# Segunda barrera: para envío real deben estar false arriba Y true aquí.
CAMPANAS_MATCHMAKING_ENVIO_REAL_HABILITADO=false
PLATICA_TEMPLATE_OFERTA_INICIAL=
# Recordatorio-reactivación del evento (disparo manual, sin cron).
# 14 días antes es referencia de producto, no un scheduler.
PLATICA_TEMPLATE_RECORDATORIO_EVENTO=
# Preferencia al elegir 3 bloques comunes: alternar antes/después de este corte.
CITAS_CORTE_MANANA_TARDE=14:00
